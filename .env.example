# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here
LLM_MODEL=gpt-4-turbo-preview
LLM_TEMPERATURE=0.7
EMBEDDING_MODEL=text-embedding-3-small

# Self-Hosted LLM Configuration (vLLM — OpenAI-compatible endpoint)
# Set llm_provider="self_host" in API requests to route calls here instead of OpenAI.
# The model served by vLLM must match the --served-model-name flag used when starting vLLM.
SELF_HOST_LLM_BASE_URL=http://<VM_IP>:8000/v1
SELF_HOST_LLM_API_KEY=EMPTY
SELF_HOST_LLM_MODEL=Qwen3-14B-AWQ-INT4

# Zilliz Cloud Configuration
# Get these from https://cloud.zilliz.com/
ZILLIZ_CLOUD_URI=https://your-cluster.serverless.aws-region.cloud.zilliz.com
ZILLIZ_CLOUD_API_KEY=your_zilliz_api_key_here
ZILLIZ_COLLECTION_NAME=learning_vec

# Vector Database Settings
VECTOR_DIM=1536
TOP_K=5

# RAG retrieve-first classification (gia sư AI)
# Ngưỡng cosine chỉ lọc rác khỏi ngữ cảnh phân loại — KHÔNG phải ranh giới từ chối/trả lời.
RAG_MIN_SCORE=0.30
# Số chunk lấy khi quét toàn khóa học để tìm bằng chứng cross-module (nhiều hơn TOP_K trong-module).
RAG_CROSS_TOP_K=20
# Biên an toàn: chỉ chấp nhận nhãn "cross_module" khi điểm cosine cao nhất module khác vượt điểm
# cao nhất module hiện tại ít nhất ngần này — chặn trường hợp LLM bị nhiễu bởi chunk cross-module
# gần trùng điểm (kể cả do lỗi dữ liệu trùng nội dung giữa hai tài liệu).
RAG_CROSS_MODULE_MARGIN=0.05
